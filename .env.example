# Copy to .env and fill in. Never commit .env.

# Which LLM provider to use for the explanation layer: "openai" or "gemini".
LLM_PROVIDER=openai

# API key for the provider above. Leave empty to run the app with the
# deterministic scoring path only; the API stays fully functional without it.
LLM_API_KEY=

# Optional model override. When unset, a per-provider default is used:
#   openai -> gpt-4o-mini
#   gemini -> gemini-2.5-flash
LLM_MODEL=

# Extraction path: "deterministic", "llm" or "hybrid" (default: hybrid).
# hybrid is the union of LLM and deterministic results, with the LLM winning
# priority conflicts. With no LLM_API_KEY set, the deterministic path is used
# regardless of this value.
EXTRACTION_MODE=hybrid
